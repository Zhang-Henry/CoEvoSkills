# Copy this file to .env and fill in only the provider you use.
# Never commit .env or credential files.

# Claude Code subscription. Authenticate with `claude auth login` first.
# CLAUDE_CODE_USE_SUBSCRIPTION=1
# CLAUDE_CODE_SUBSCRIPTION_MODEL=claude-opus-4-6

# Anthropic API
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Vertex AI for Claude. Authenticate with `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# CLOUD_ML_REGION=us-east5
# VERTEXAI_LOCATION=us-east5
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_MODEL=claude-opus-4-6
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-6
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-opus-4-6
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-opus-4-6
# CLAUDE_CODE_SUBAGENT_MODEL=claude-opus-4-6

# Vertex AI for Gemini (uses the same ADC file).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Amazon Bedrock. Prefer a bearer token or short-lived AWS credentials.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-2
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-token
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# ANTHROPIC_MODEL=us.anthropic.claude-opus-4-6-v1

# Gemini Developer API
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=

# OpenAI API
# OPENAI_API_KEY=your-openai-api-key

# Codex ChatGPT subscription. Authenticate with `codex login` first.
# CODEX_CHATGPT_AUTH_FILE=/absolute/path/to/.codex/auth.json
# CODEX_CLI_BINARY=/absolute/path/to/codex
# CODEX_REASONING_EFFORT=low

# Azure OpenAI
# AZURE_API_KEY=your-azure-openai-key
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=your-api-version
